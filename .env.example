# Copy to .env (git-ignored) and fill in real values locally. Placeholders only - never commit real secrets.
SERVER_PORT=8081

# Used from Milestone 2 onwards (XAMPP MariaDB). Tests use banking_mgmt_test_db with the same user/password.
SPRING_DATASOURCE_URL=jdbc:mariadb://localhost:3306/banking_mgmt_db
SPRING_DATASOURCE_USERNAME=banking_app
SPRING_DATASOURCE_PASSWORD=replace_me_locally

# Used from Milestone 4 onwards. At least 32 characters; the app refuses to start otherwise.
# Generate one in PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=replace_with_a_long_random_secret
# Browser origins allowed to call the API (comma-separated). Defaults to the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Docker only (docker-compose.yml): root password of the MariaDB container. Not used by the app itself.
DB_ROOT_PASSWORD=replace_with_a_different_local_password

# API documentation (Swagger UI). Set to false for a public deployment.
API_DOCS_ENABLED=true

# Used by the React app (Milestone 6). Vite variables are PUBLIC - never put secrets here.
VITE_API_BASE_URL=http://localhost:8081/api/v1
