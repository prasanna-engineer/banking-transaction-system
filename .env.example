# Copy to .env (git-ignored) and fill in real values locally. Placeholders only - never commit real secrets.
SERVER_PORT=8081

# Used from Milestone 2 onwards (XAMPP MariaDB). Tests use banking_mgmt_test_db with the same user/password.
SPRING_DATASOURCE_URL=jdbc:mariadb://localhost:3306/banking_mgmt_db
SPRING_DATASOURCE_USERNAME=banking_app
SPRING_DATASOURCE_PASSWORD=replace_me_locally

# Used from Milestone 4 onwards
JWT_SECRET=replace_with_a_long_random_secret

# Used by the React app (Milestone 6). Vite variables are PUBLIC - never put secrets here.
VITE_API_BASE_URL=http://localhost:8081/api/v1
